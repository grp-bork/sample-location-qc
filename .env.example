# Copy to .env (git-ignored) and fill in. run.sh reads it.

# metalog-geocoding service (https://github.com/grp-bork/metalog-geocoding);
# a local `python service/app.py` listens on the address below
METALOG_GEOCODING_URL=http://localhost:8007

# A checkout of the same metalog-geocoding version with data/ set up
# (scripts/setup_data.py): flag_coords.py reads its Natural Earth / IHO layers
# and country aliases
METALOG_GEOCODING_DIR=/path/to/metalog-geocoding

# Service responses, shared by all runs (default: cache/)
# CACHE_DIR=cache
